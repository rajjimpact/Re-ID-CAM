# .env.example  —  Copy to .env and fill in your values.
# The system reads .env automatically at startup via python-dotenv.

# ── Server ───────────────────────────────────────────────────────────────────
REID_HOST=0.0.0.0
REID_PORT=8000

# ── Authentication ────────────────────────────────────────────────────────────
# Leave empty to DISABLE authentication (default for local testing).
REID_API_KEY=

# ── Camera Sources (1 Laptop Webcam + 3 Phones) ──────────────────────────────
#
# Camera 0: Laptop Webcam
# Device index 0 is your laptop's built-in webcam.
CAM_0_SOURCE=0
CAM_0_NAME=Laptop Webcam
CAM_0_ZONE=Zone A - Entrance

# Camera 1: Phone 1 (Wi-Fi IP Webcam or USB)
# Replace 192.168.1.101 with Phone 1's IP address
CAM_1_SOURCE=http://192.168.1.101:8080/video
CAM_1_NAME=Phone 1
CAM_1_ZONE=Zone B - Electronics

# Camera 2: Phone 2 (Wi-Fi IP Webcam or USB)
# Replace 192.168.1.102 with Phone 2's IP address
CAM_2_SOURCE=http://192.168.1.102:8080/video
CAM_2_NAME=Phone 2
CAM_2_ZONE=Zone C - Grocery

# Camera 3: Phone 3 (Wi-Fi IP Webcam or USB)
# Replace 192.168.1.103 with Phone 3's IP address
CAM_3_SOURCE=http://192.168.1.103:8080/video
CAM_3_NAME=Phone 3
CAM_3_ZONE=Zone D - Checkout
