# .env.example  —  Copy to .env and fill in your values.
# The system reads this file automatically at startup via python-dotenv.

# ── Server ───────────────────────────────────────────────────────────────────
REID_HOST=0.0.0.0
REID_PORT=8000

# ── Authentication ────────────────────────────────────────────────────────────
# Leave empty to DISABLE authentication (safe for local dev, insecure in prod).
# Set to any strong random string for production.
REID_API_KEY=

# ── Camera Sources (2 live cameras: Laptop + Phone) ───────────────────────────
# Uncomment and edit the lines below to override defaults from config.py.

# Camera 0: Laptop built-in or USB webcam
# 0 = first webcam device index (built-in), 1 = second (external USB)
# CAM_0_SOURCE=0
# CAM_0_ZONE=Zone A
# CAM_0_NAME=Laptop Webcam

# Camera 1: Phone camera via IP Webcam app (Android) over Wi-Fi
# Steps:
#   1. Install "IP Webcam" from Play Store (by Pavel Khlebovich)
#   2. Connect phone and laptop to the SAME Wi-Fi network
#   3. Open app → scroll down → tap "Start server"
#   4. Note the IP shown on the phone screen (e.g. http://192.168.1.45:8080)
#   5. Replace 192.168.1.45 below with your phone's actual IP
# CAM_1_SOURCE=http://192.168.1.45:8080/video
# CAM_1_ZONE=Zone B
# CAM_1_NAME=Phone Camera

# ── iOS Alternative: iVCam / Camo ─────────────────────────────────────────────
# Install iVCam (free) on iPhone + iVCam PC client from eLMT Corp.
# The phone appears as a Windows virtual webcam at device index 1 or 2.
# CAM_1_SOURCE=1
# CAM_1_ZONE=Zone B
# CAM_1_NAME=iPhone Camera (iVCam)
