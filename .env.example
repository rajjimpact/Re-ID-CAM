# .env.example  —  Copy to .env and fill in your values.
# The system reads this file automatically at startup via python-dotenv.

# ── Server ───────────────────────────────────────────────────────────────────
REID_HOST=0.0.0.0
REID_PORT=8000

# ── Authentication (Phase 7) ─────────────────────────────────────────────────
# Leave empty to DISABLE authentication (safe for local dev, insecure in prod).
# Set to any strong random string for production.
REID_API_KEY=

# ── Camera sources (Phase 5/8) ───────────────────────────────────────────────
# Override these to point at your real cameras without editing config.py.
# Values: device index (0,1,2...), file path, or rtsp://... URL.
# CAM_0_SOURCE=0
# CAM_0_ZONE=Entrance
# CAM_0_NAME=Entrance Camera

# CAM_1_SOURCE=rtsp://admin:password@192.168.1.11/stream1
# CAM_1_ZONE=Electronics
# CAM_1_NAME=Electronics Camera

# CAM_2_SOURCE=rtsp://admin:password@192.168.1.12/stream1
# CAM_2_ZONE=Grocery
# CAM_2_NAME=Grocery Camera

# CAM_3_SOURCE=rtsp://admin:password@192.168.1.13/stream1
# CAM_3_ZONE=Checkout
# CAM_3_NAME=Checkout Camera
